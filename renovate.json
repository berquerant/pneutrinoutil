{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": [
    "main"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pnpm/pnpm",
      "description": "Manage pnpm version in ui/Dockerfile",
      "fileMatch": [
        "^ui/Dockerfile$"
      ],
      "matchStrings": [
        "PNPM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lima-vm/lima",
      "description": "Manage lima version",
      "fileMatch": [
        "^.github/actions/setup-lima/action.yaml$"
      ],
      "matchStrings": [
        "default: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "kindest/node",
      "description": "Manage KIND_NODE_IMAGE version in mise.toml",
      "fileMatch": [
        "^mise.toml$"
      ],
      "matchStrings": [
        "KIND_NODE_IMAGE = \"kindest/node:(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    }
  ],
  "extends": [
    "github>berquerant/renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "addLabels": [
        "docker"
      ],
      "description": "Group docker dependencies",
      "groupName": "docker({{updateType}}): {{depName}}",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "go"
      ],
      "description": "Group go dependencies",
      "groupName": "go({{updateType}}) in {{#if packageFileDir}}{{packageFileDir}}{{else}}root{{/if}}",
      "matchDatasources": [
        "go"
      ]
    },
    {
      "addLabels": [
        "mise"
      ],
      "description": "Group mise tool updates",
      "matchManagers": [
        "mise"
      ]
    },
    {
      "addLabels": [
        "node"
      ],
      "description": "Group node updates across mise and Dockerfile",
      "groupName": "node",
      "matchPackageNames": [
        "node",
        "docker.io/library/node"
      ]
    },
    {
      "addLabels": [
        "pnpm"
      ],
      "description": "Group pnpm updates across mise, Dockerfile, and package.json",
      "groupName": "pnpm",
      "matchPackageNames": [
        "pnpm",
        "pnpm/pnpm",
        "@pnpm/exe"
      ]
    },
    {
      "addLabels": [
        "go"
      ],
      "description": "Group Go language updates across mise, go.mod, and Dockerfile",
      "groupName": "go",
      "matchPackageNames": [
        "go",
        "golang",
        "docker.io/library/golang"
      ]
    },
    {
      "addLabels": [
        "lima"
      ],
      "description": "Group Lima updates across mise and setup-lima action",
      "groupName": "lima",
      "matchPackageNames": [
        "lima",
        "lima-vm/lima"
      ]
    },
    {
      "addLabels": [
        "swag"
      ],
      "description": "Group Swag CLI and Go module updates",
      "groupName": "swag",
      "matchPackageNames": [
        "swag",
        "github.com/swaggo/swag",
        "github.com/swaggo/swag/v2"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
