{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": [
    "main"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv",
      "description": "Manage uv version in bin/lima.sh",
      "fileMatch": [
        "^bin/lima.sh$"
      ],
      "matchStrings": [
        "uv_version=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pnpm/pnpm",
      "description": "Manage pnpm version in bin/lima.sh and ui/Dockerfile",
      "fileMatch": [
        "^bin/lima.sh$",
        "^ui/Dockerfile$"
      ],
      "matchStrings": [
        "pnpm_version=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "PNPM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lima-vm/lima",
      "description": "Manage lima version",
      "fileMatch": [
        "^.github/actions/setup-lima/action.yaml$"
      ],
      "matchStrings": [
        "default: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fe3dback/go-arch-lint",
      "description": "Manage go-arch-lint version in mise.toml",
      "fileMatch": [
        "^mise.toml$"
      ],
      "matchStrings": [
        "\"aqua:fe3dback/go-arch-lint\" = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "kindest/node",
      "description": "Manage KIND_NODE_IMAGE version in mise.toml",
      "fileMatch": [
        "^mise.toml$"
      ],
      "matchStrings": [
        "KIND_NODE_IMAGE = \"kindest/node:(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    }
  ],
  "extends": [
    "github>berquerant/renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "addLabels": [
        "docker"
      ],
      "description": "Group docker dependencies",
      "groupName": "docker({{updateType}}): {{depName}}",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "go"
      ],
      "description": "Group go dependencies",
      "groupName": "go({{updateType}}) in {{#if packageFileDir}}{{packageFileDir}}{{else}}root{{/if}}",
      "matchDatasources": [
        "go"
      ]
    },
    {
      "addLabels": [
        "mise"
      ],
      "description": "Group mise tool updates",
      "matchManagers": [
        "mise"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
